{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "agents/docs-pr/hooks/require-review-clear.py",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "hooks/lib/record-stage-start.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "agents/docs-pr/hooks/block-open-pr.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "agents/docs-pr/hooks/block-open-pr.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "hooks/lib/verify-stage-complete.py",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
