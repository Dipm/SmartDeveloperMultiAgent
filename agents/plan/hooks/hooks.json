{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "agents/plan/hooks/require-context.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "agents/plan/hooks/block-implementation.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "agents/plan/hooks/block-implementation.py",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
